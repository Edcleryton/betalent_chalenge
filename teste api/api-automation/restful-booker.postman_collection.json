				{
					"name": "CreateBooking - JSON",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Store Booking ID\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.bookingid).to.be.a('number');",
									"    pm.environment.set(\"booking_id\", jsonData.bookingid);",
									"});",
									"pm.test(\"Dados criados correspondem ao payload enviado\", function () {",
									"    var data = pm.response.json().booking;",
									"    pm.expect(data.firstname).to.eql(\"Jim\");",
									"    pm.expect(data.lastname).to.eql(\"Brown\");",
									"    pm.expect(data.totalprice).to.eql(111);",
									"    pm.expect(data.depositpaid).to.eql(true);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"firstname\" : \"Jim\",\n    \"lastname\" : \"Brown\",\n    \"totalprice\" : 111,\n    \"depositpaid\" : true,\n    \"bookingdates\" : {\n        \"checkin\" : \"2024-01-01\",\n        \"checkout\" : \"2024-01-02\"\n    },\n    \"additionalneeds\" : \"Breakfast\"\n}"
