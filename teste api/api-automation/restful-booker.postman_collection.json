				{
					"name": "GetBooking",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Validate Schema - campos obrigatórios presentes\", function () {",
									"    var data = pm.response.json();",
									"    pm.expect(data).to.have.property('firstname');",
									"    pm.expect(data).to.have.property('lastname');",
									"    pm.expect(data).to.have.property('totalprice');",
									"    pm.expect(data).to.have.property('depositpaid');",
									"    pm.expect(data).to.have.property('bookingdates');",
									"    pm.expect(data.bookingdates).to.have.property('checkin');",
									"    pm.expect(data.bookingdates).to.have.property('checkout');",
									"});",
									"pm.test(\"Validate Schema - tipos de dados corretos\", function () {",
									"    var data = pm.response.json();",
									"    pm.expect(data.firstname).to.be.a('string');",
									"    pm.expect(data.lastname).to.be.a('string');",
									"    pm.expect(data.totalprice).to.be.a('number');",
									"    pm.expect(data.depositpaid).to.be.a('boolean');",
									"    pm.expect(data.bookingdates.checkin).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
									"    pm.expect(data.bookingdates.checkout).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
									"});"
								],
								"type": "text/javascript"
