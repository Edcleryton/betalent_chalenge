{
    "name":  "qa-automation-lab-api",
    "version":  "1.0.0",
    "description":  "API testing study project using Postman and Newman",
    "main":  "index.js",
    "scripts":  {
                    "test":  "newman run api_automation/restful-booker.postman_collection.json -e api_automation/restful-booker.postman_environment.json --reporters cli,htmlextra,json --reporter-htmlextra-export reports/report.html --reporter-json-export reports/results.json",
                    "test:cli":  "newman run api_automation/restful-booker.postman_collection.json -e api_automation/restful-booker.postman_environment.json --reporters cli"
                },
    "keywords":  [
                     "qa",
                     "test",
                     "api",
                     "postman",
                     "newman"
                 ],
    "author":  "Edcleryton Silva",
    "license":  "ISC",
    "devDependencies":  {
                            "newman":  "6.1.2",
                            "newman-reporter-htmlextra":  "1.22.11"
                        }
}
